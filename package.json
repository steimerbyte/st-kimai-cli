{
  "name": "st-kimai-cli",
  "version": "2.0.2",
  "type": "module",
  "description": "CLI tool for Kimai time-tracking API",
  "main": "dist/index.js",
  "bin": {
    "kimai-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:html": "vitest run --coverage --reporter=html"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "kimai",
    "time-tracking",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "ora": "^5.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "@vitest/coverage-v8": "4.1.7",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "vitest": {
    "test": {
      "include": [
        "src/**/*.test.ts"
      ],
      "environment": "node"
    }
  }
}
